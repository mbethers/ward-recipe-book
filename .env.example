# Copy this file to .env for local development. On Render, set these as
# real environment variables in the dashboard instead - never commit a .env file.

# Church name shown in the header
WARD_NAME=University Ward

# Password for the /admin review panel (pick something simple but not guessable)
ADMIN_PASSWORD=change-me

# Random string used to sign the admin login session cookie. Any long random
# string works - generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-too

# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase project (Settings -> API in the Supabase dashboard). Used for
# storing uploaded photos/PDFs so they survive Render restarts/redeploys.
SUPABASE_URL=
# Use the service_role secret key here (NOT the anon/public key) - this key
# is server-side only and must never be exposed to the browser.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=recipe-photos

# Same Supabase project's Postgres database - this is where recipes/themes
# actually live (Render's free tier has no persistent disk, so SQLite would
# lose everything on every redeploy). Get this from the Supabase dashboard:
# Project Settings -> Database -> Connection string -> "Transaction pooler"
# (port 6543). Fill in the password you set when creating the project.
DATABASE_URL=
